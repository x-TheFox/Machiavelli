STOCKFISH_PATH=/opt/homebrew/bin/stockfish
STOCKFISH_THREADS=2
STOCKFISH_HASH=64
DEFAULT_SEARCH_DEPTH=6
DEFAULT_SEARCH_MOVETIME_MS=1000
DEFAULT_MULTIPV=5

OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

DATABASE_URL=sqlite+aiosqlite:///./machiavelli.db
HOST=0.0.0.0
PORT=8000
DEBUG=false
