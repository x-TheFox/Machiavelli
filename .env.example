# ============================================================
# Machiavelli Environment Configuration Template
# Copy this file to .env and configure your credentials safely.
# DO NOT commit .env with real credentials to source control.
# ============================================================

# Stockfish UCI Chess Engine
STOCKFISH_PATH=/opt/homebrew/bin/stockfish
STOCKFISH_THREADS=2
STOCKFISH_HASH=64
DEFAULT_SEARCH_DEPTH=6
DEFAULT_SEARCH_MOVETIME_MS=1000
DEFAULT_MULTIPV=5

# OpenAI / Gemini API Configuration
OPENAI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gemini-2.5-flash
OPENAI_FALLBACK_MODELS=["gemini-2.5-flash", "gemini-2.5-pro", "gemini-2.0-flash", "gemini-1.5-flash"]

# Database & Server Settings
DATABASE_URL=sqlite+aiosqlite:///./machiavelli.db
HOST=0.0.0.0
PORT=8000
DEBUG=false
